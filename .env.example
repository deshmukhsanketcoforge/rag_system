# Copy to .env and fill in. Never commit .env.
# Azure AI Foundry (the only LLM provider). Locally these live here; in CI they are repository secrets.
ANTHROPIC_FOUNDRY_API_KEY=your-foundry-key
ANTHROPIC_FOUNDRY_BASE_URL=https://<your-resource>.services.ai.azure.com/anthropic
# Optional: the Foundry deployment name sent as the model (default: claude-opus-5-5-fast)
# RAG_LLM_MODEL=claude-opus-5-5-fast
